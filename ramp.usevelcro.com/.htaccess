# Velcro Ramp — production document root rules
# Extract these files into your hosting account's public_html/ folder.
DirectoryIndex index.html index.php
Options -Indexes -ExecCGI
ServerSignature Off

# Block access to hidden files
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Deny direct access to sensitive file extensions
<FilesMatch "\.(env|git|gitignore|md|log|sql|sh|bat|ps1|zip|tar|gz)$">
    Require all denied
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "0"
    # Uncomment after HTTPS is confirmed working:
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Gzip compression for text assets
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Ensure /goat redirects to /goat/ cleanly
    RewriteRule ^goat$ /goat/ [R=301,L]

    # Serve existing files/directories directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route API and webhook requests to the backend
    RewriteRule ^(api|webhook)/.*$ index.php [L]

    # Everything else -> index.html (SPA fallback)
    RewriteRule ^ index.html [L]
</IfModule>

# PHP production settings
<IfModule mod_php.c>
    php_flag display_errors off
    php_value upload_max_filesize 2M
    php_value post_max_size 8M
    php_value max_execution_time 60
</IfModule>

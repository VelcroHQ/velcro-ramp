# Velcro Ramp — production document root rules (deployed 2026-10-24)
DirectoryIndex index.html index.php
ServerSignature Off
ErrorDocument 404 /404.html

# Pass Authorization header to CGI/PHP environment
CGIPassAuth On
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

# Block access to hidden files except .well-known
<FilesMatch "^\.(?!well-known)">
    Require all denied
</FilesMatch>

# Allow .well-known directory access (ACME, WebFinger, MCP, etc.)
<If "%{REQUEST_URI} =~ m#^/\.well-known/#">
    Require all granted
</If>

# Deny direct access to sensitive file extensions (allow index.md for markdown negotiation)
<FilesMatch "(?<!index)\.(env|git|gitignore|md|log|sql|sh|bat|ps1|zip|tar|gz)$">
    Require all denied
</FilesMatch>

# Serve MCP server-card.json as JSON
<Files "server-card.json">
    Require all granted
    ForceType application/json
    Header set Content-Type "application/json; charset=utf-8"
    Header set Access-Control-Allow-Origin "*"
</Files>

# Serve llms.txt as plain text
<FilesMatch "llms(-full)?\.txt$">
    Require all granted
    ForceType text/plain
    Header set Content-Type "text/plain; charset=utf-8"
    Header set Access-Control-Allow-Origin "*"
</FilesMatch>

# Security, Agent & Resource Link headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "0"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Content-Signal "search=yes, ai-train=no"
    Header set Link '<https://ramp.usevelcro.com/llms.txt>; rel="describedby"; type="text/plain", <https://ramp.usevelcro.com/?format=markdown>; rel="alternate"; type="text/markdown"'
</IfModule>

# Gzip compression for text assets
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json text/plain text/markdown
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
</IfModule>

# CSS/JS change on every deploy but their URLs don't: make browsers revalidate
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ── Redirect apex domain usevelcro.com to www.usevelcro.com (Vercel landing page) ──
    RewriteCond %{HTTP_HOST} ^usevelcro\.com$ [NC]
    RewriteRule ^(.*)$ https://www.usevelcro.com/$1 [R=301,L]

    # ── Content Negotiation: Serve Markdown for Agents ──
    RewriteCond %{HTTP:Accept} text/(x-)?markdown [NC]
    RewriteCond %{REQUEST_URI} ^/?(index\.(html|php))?$
    RewriteRule ^ index.php?format=markdown [L]

    # Allow .well-known pass-through
    RewriteRule ^\.well-known/ - [L]

    # Pass Authorization header to CGI/PHP environment
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

    # Backend internals are never served directly (tests, schema, runtime data)
    RewriteRule ^php-backend/(tests|sql|data)(/|$) - [R=404,L]

    # ── Redirect old /goat and /merchant paths on ramp to their standalone subdomains ──
    RewriteCond %{HTTP_HOST} ^ramp\.usevelcro\.com$ [NC]
    RewriteRule ^goat(/.*)?$ https://goat.usevelcro.com$1 [R=301,L]

    RewriteCond %{HTTP_HOST} ^ramp\.usevelcro\.com$ [NC]
    RewriteRule ^merchant(/.*)?$ https://merchant.usevelcro.com$1 [R=301,L]

    # ── Subdomain: goat.usevelcro.com ──
    RewriteCond %{HTTP_HOST} ^goat\.usevelcro\.com$ [NC]
    RewriteRule ^(api|webhook)/.*$ index.php [L]

    RewriteCond %{HTTP_HOST} ^goat\.usevelcro\.com$ [NC]
    RewriteCond %{DOCUMENT_ROOT}/goat/$1 -f
    RewriteRule ^(.*)$ goat/$1 [L]

    RewriteCond %{HTTP_HOST} ^goat\.usevelcro\.com$ [NC]
    RewriteRule ^$ goat/index.html [L]

    RewriteCond %{HTTP_HOST} ^goat\.usevelcro\.com$ [NC]
    RewriteRule ^(.*)$ goat/index.html [L]

    # ── Subdomain: merchant.usevelcro.com ──
    RewriteCond %{HTTP_HOST} ^merchant\.usevelcro\.com$ [NC]
    RewriteRule ^(api|webhook)/.*$ index.php [L]

    # Redirect .html to clean pretty URL on merchant subdomain
    RewriteCond %{HTTP_HOST} ^merchant\.usevelcro\.com$ [NC]
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # Clean pretty URLs for merchant legal pages (/terms -> merchant/terms.html)
    RewriteCond %{HTTP_HOST} ^merchant\.usevelcro\.com$ [NC]
    RewriteCond %{DOCUMENT_ROOT}/merchant/$1.html -f
    RewriteRule ^([^/]+)/?$ merchant/$1.html [L]

    RewriteCond %{HTTP_HOST} ^merchant\.usevelcro\.com$ [NC]
    RewriteCond %{DOCUMENT_ROOT}/merchant/$1 -f
    RewriteRule ^(.*)$ merchant/$1 [L]

    RewriteCond %{HTTP_HOST} ^merchant\.usevelcro\.com$ [NC]
    RewriteRule ^$ merchant/index.html [L]

    RewriteCond %{HTTP_HOST} ^merchant\.usevelcro\.com$ [NC]
    RewriteRule ^(.*)$ merchant/index.html [L]

    # ── Wildcard Merchant Exchanges: {slug}.usevelcro.com ──
    RewriteCond %{HTTP_HOST} ^([a-z0-9-]+)\.usevelcro\.com$ [NC]
    RewriteCond %1 !^(www|ramp|goat|merchant|api|admin|mail|cpanel|webmail)$ [NC]
    RewriteRule ^(api|webhook)/.*$ index.php [L]

    RewriteCond %{HTTP_HOST} ^([a-z0-9-]+)\.usevelcro\.com$ [NC]
    RewriteCond %1 !^(www|ramp|goat|merchant|api|admin|mail|cpanel|webmail)$ [NC]
    RewriteCond %{DOCUMENT_ROOT}/store/$1 -f
    RewriteRule ^(.*)$ store/$1 [L]

    RewriteCond %{HTTP_HOST} ^([a-z0-9-]+)\.usevelcro\.com$ [NC]
    RewriteCond %1 !^(www|ramp|goat|merchant|api|admin|mail|cpanel|webmail)$ [NC]
    RewriteRule ^$ store/index.html [L]

    RewriteCond %{HTTP_HOST} ^([a-z0-9-]+)\.usevelcro\.com$ [NC]
    RewriteCond %1 !^(www|ramp|goat|merchant|api|admin|mail|cpanel|webmail)$ [NC]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    RewriteCond %{HTTP_HOST} ^([a-z0-9-]+)\.usevelcro\.com$ [NC]
    RewriteCond %1 !^(www|ramp|goat|merchant|api|admin|mail|cpanel|webmail)$ [NC]
    RewriteRule ^(.*)$ store/index.html [L]

    # ── Standard Main Site: ramp.usevelcro.com ──
    # Redirect .html to clean pretty URL
    RewriteCond %{THE_REQUEST} \s/+(about|contact|terms|privacy)\.html[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # Pretty URLs for core pages
    RewriteRule ^(about|contact|terms|privacy)/?$ $1.html [L]

    # Serve existing files/directories directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Legacy /m/{store} backward-compatible route
    RewriteRule ^m/[a-z0-9-]{3,30}/?$ store/index.html [L]

    # Route API and webhook requests to the backend
    RewriteRule ^(api|webhook)/.*$ index.php [L]

    # Serve index.html for root only
    RewriteRule ^$ index.html [L]

    # Return real 404 for missing non-API routes
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ - [R=404,L]
</IfModule>

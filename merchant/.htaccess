# Velcro Ramp — Merchant portal protection and routing rules
DirectoryIndex index.html index.php

# Enable passing Authorization header to PHP CGI
CGIPassAuth On
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

# Security headers & cache control
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "0"

    # Always revalidate merchant portal and storefront assets so updates are immediate
    <FilesMatch "\.(html|htm|js|css)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# Block hidden files
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Pass Authorization header to CGI/PHP environment
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

    # ── Merchant Storefronts (e.g. megamind.usevelcro.com) ──
    # When accessed via a merchant's custom subdomain (not merchant.usevelcro.com)
    RewriteCond %{HTTP_HOST} !^merchant\.usevelcro\.com$ [NC]
    RewriteCond %{HTTP_HOST} !^ramp\.usevelcro\.com$ [NC]
    RewriteCond %{HTTP_HOST} !^goat\.usevelcro\.com$ [NC]
    RewriteRule ^(api|webhook)/.*$ index.php [L]

    RewriteCond %{HTTP_HOST} !^merchant\.usevelcro\.com$ [NC]
    RewriteCond %{HTTP_HOST} !^ramp\.usevelcro\.com$ [NC]
    RewriteCond %{HTTP_HOST} !^goat\.usevelcro\.com$ [NC]
    RewriteCond %{DOCUMENT_ROOT}/store/$1 -f
    RewriteRule ^(.*)$ store/$1 [L]

    RewriteCond %{HTTP_HOST} !^merchant\.usevelcro\.com$ [NC]
    RewriteCond %{HTTP_HOST} !^ramp\.usevelcro\.com$ [NC]
    RewriteCond %{HTTP_HOST} !^goat\.usevelcro\.com$ [NC]
    RewriteRule ^$ store/index.html [L]

    RewriteCond %{HTTP_HOST} !^merchant\.usevelcro\.com$ [NC]
    RewriteCond %{HTTP_HOST} !^ramp\.usevelcro\.com$ [NC]
    RewriteCond %{HTTP_HOST} !^goat\.usevelcro\.com$ [NC]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    RewriteCond %{HTTP_HOST} !^merchant\.usevelcro\.com$ [NC]
    RewriteCond %{HTTP_HOST} !^ramp\.usevelcro\.com$ [NC]
    RewriteCond %{HTTP_HOST} !^goat\.usevelcro\.com$ [NC]
    RewriteRule ^(.*)$ store/index.html [L]

    # ── Standard Merchant Portal (merchant.usevelcro.com) ──
    # Redirect .html requests to clean URLs (e.g. /terms.html -> /terms)
    RewriteCond %{THE_REQUEST} \s/+(about|contact|terms|privacy)\.html[\s?] [NC]
    RewriteRule ^ %1 [R=301,L]

    # Serve clean URLs (e.g. /terms -> terms.html, /privacy -> privacy.html)
    RewriteRule ^(about|contact|terms|privacy)/?$ $1.html [L]

    # If requested as /merchant/asset.ext, strip the /merchant/ prefix
    RewriteRule ^merchant/(.*)$ $1 [L]

    # Route API and webhook requests to index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(api|webhook)/.*$ index.php [L]
</IfModule>


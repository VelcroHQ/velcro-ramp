# Velcro Ramp — PHP Backend Environment Variables
# Copy this file to .env and fill in your real values.

# MySQL Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=velcro_ramp
DB_USER=root
DB_PASS=your_mysql_password

# Switch API
SWITCH_BASE_URL=https://api.onswitch.xyz
SWITCH_SERVICE_KEY=your_switch_service_key
SWITCH_WEBHOOK_SECRET=your_switch_webhook_secret

# PAJ Ramp (direct HTTP API)
PAJ_API_KEY=your_paj_api_key
PAJ_ENV=production
PAJ_WEBHOOK_SECRET=your_paj_webhook_secret
PAJ_EMAIL=paj@usevelcro.com
PAJ_BASE_URL=https://api.paj.ramp

# Admin & Fees
ADMIN_PASSWORD=your_secure_admin_password
DEVELOPER_FEE=0.5
DEVELOPER_RECIPIENT=your_solana_wallet_address
DEVELOPER_WITHDRAW_ASSET=solana:usdc
WITHDRAWAL_ALLOWED_RECIPIENTS=your_solana_wallet_address

# Notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@usevelcro.com
ADMIN_EMAIL=admin@usevelcro.com

# Hosting / Callbacks
CALLBACK_URL=https://yourdomain.com
CORS_ORIGINS=*

# Auto Withdrawal
AUTO_WITHDRAWAL_ENABLED=false
AUTO_WITHDRAWAL_SCHEDULE=0 0 * * *
AUTO_WITHDRAWAL_MIN_BALANCE=1

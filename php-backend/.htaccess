# Velcro Ramp — backend directory protection
#
# This directory should NOT be the document root. It is normally reached only
# through the rewrite rules in public/.htaccess (or the root fallback .htaccess).
# These rules add defense-in-depth in case the directory is ever exposed.

Options -Indexes -ExecCGI
ServerSignature Off

# Allow only the front controller to execute
<FilesMatch "^(?!index\.php$).*\.php$">
    Require all denied
</FilesMatch>

# Deny access to runtime data, tests, SQL, cron, and tools
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(data|tests|sql|cron|tools)/ - [F,L]
</IfModule>

# Deny access to hidden and sensitive files
<FilesMatch "^\.|\.(env|log|sql|json|md|zip|tar|gz)$">
    Require all denied
</FilesMatch>
